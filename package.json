{
  "name": "ai-writing-engine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AI写作伴侣 — 从大纲到创作的完整AI辅助工作流",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx backend/server.ts\"",
    "dev:frontend": "vite",
    "dev:backend": "tsx watch backend/server.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx backend/server.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@anthropic-ai/sdk": "^0.104.1",
    "@codemirror/lang-markdown": "^6.3.2",
