    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@uiw/react-codemirror": "^4.23.10",
    "antd": "^6.0.0",
    "codemirror": "^6.0.1",
    "cors": "^2.8.6",
    "diff": "^8.0.2",
    "docx": "^9.7.1",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "idb": "^8.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.11.0",
    "openai": "^4.86.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.5.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/diff": "^8.0.0",
    "@types/express": "^5.0.1",
    "@types/morgan": "^1.9.10",
