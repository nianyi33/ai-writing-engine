{
  "productName": "AI写作引擎",
  "version": "1.0.0",
  "identifier": "com.ai-writing-engine.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI写作引擎",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.png"],
    "resources": ["resources/backend-bundle.cjs"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
