{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev:frontend",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ai-writing-engine-backend.up.railway.app/api/:path*"
    }
  ]
}
